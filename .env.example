# Server only. Never use a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional. Leave blank to retry only GEMINI_MODEL.
GEMINI_FALLBACK_MODEL=

# Owner-only reading on hosted deployments. Set privately, never with VITE_.
# Use two different random values; do not reuse your Gemini API key.
# Password: 16-256 characters. Session secret: 32-256 characters.
VOUCHERQUILL_ACCESS_PASSWORD=
VOUCHERQUILL_SESSION_SECRET=
